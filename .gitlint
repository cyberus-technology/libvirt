[general]
extra-path=ci/gitlint/rules
regex-style-search=true
ignore=body-is-missing,body-max-line-length

[ignore-by-author-name]
regex=dependabot
ignore=all

# default 72
[title-max-length]
line-length=72

# Empty bodies are fine
[body-min-length]
min-length=0

# Following is a list of directories and files that are Cyberus exclusive,
# meaning these files do not exist upstream and they are not meant for
# upstreaming, e.g. our Nix related changes.
# The list is used as a filter to prevent mixing Cyberus exclusive changes with
# potentially upstreamable changes in commits.
[UC-scope]
filter-paths=nixos-tests,local_tests,patches,ci/gitlint,ci/README.auto.approve.md,ci/auto_approve.sh,flake.nix,flake.lock,.gitlab-ci.yml,.envrc,.gitlint_auto_approve,.gitlint
